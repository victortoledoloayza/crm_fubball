# Copia este archivo a .env y completa los valores reales.
# .env NUNCA debe subirse al repositorio (ver .gitignore) — en local y en
# producción el código es el mismo, lo único que cambia es este archivo.

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fubball_kds
DB_USER=
DB_PASS=

# --- Entorno de la aplicación ---
# local | production — en production se desactiva la salida de errores PHP.
APP_ENV=local

# URL base del proyecto, SIN slash final. Se usa para construir todas las
# redirecciones (login, logout, links del menú) de forma que funcionen
# igual si el proyecto vive en la raíz del dominio o en una subcarpeta
# (típico en hosting compartido tipo cPanel).
APP_URL=http://localhost/fubball_kds

# --- Sesión ---
SESSION_NAME=fubball_kds_session
SESSION_LIFETIME_MIN=480

# --- Integraciones (Fase 7) ---
# Secreto del webhook de Shopify (Admin → Notifications → Webhooks, o
# app privada). Shopify lo muestra UNA vez al crear el webhook — se usa
# para verificar la firma HMAC de cada request entrante, nunca se envía
# a ningún lado.
SHOPIFY_WEBHOOK_SECRET=
