# Bloquea todo acceso directo por navegador a esta carpeta. El código de
# aquí solo debe ejecutarse vía require/require_once desde scripts en la
# raíz del proyecto, nunca cargarse directo por URL.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
