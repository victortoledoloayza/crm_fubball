/.env
/vendor/
.DS_Store

# Etiquetas PDF subidas por usuarios — nunca van al repo.
/uploads/
# Archivos de entorno y credenciales
.env
.env.local
.env.production

# Bases de datos y volcados SQL
*.sql
*.sqlite

# Excepción: migraciones versionadas (CREATE/ALTER incrementales, sin datos)
# sí se suben — a diferencia de dumps sueltos o exports con datos reales.
!scripts/migraciones/*.sql

# Archivos subidos por usuarios (etiquetas)
uploads/etiquetas/*
!uploads/etiquetas/.gitkeep

# Logs y archivos temporales
*.log
.DS_Store
Thumbs.db

# Archivos subidos por usuarios (etiquetas)
!/uploads/etiquetas/
uploads/etiquetas/*
!uploads/etiquetas/.gitkeep
!uploads/etiquetas/.htaccess

# Archivos subidos por usuarios (respuestas rápidas)
!/uploads/respuestas_rapidas/
uploads/respuestas_rapidas/*
!uploads/respuestas_rapidas/.gitkeep
!uploads/respuestas_rapidas/.htaccess